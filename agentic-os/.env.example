# Copy to .env and fill in. All optional — sensible defaults are used otherwise.

# Absolute path to your Obsidian vault. Chats, goals, and journal entries are
# written to <vault>/<OBSIDIAN_FOLDER>/. ~ is expanded to your home directory.
OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVault

# Sub-folder created inside the vault.
OBSIDIAN_FOLDER=Agentic OS

# Command used for the Claude Code CLI bridge (must be on your PATH).
CLAUDE_CLI=claude

# Set to 1 to force every agent to show LIVE (handy for screenshots/demos).
AGENTIC_OS_DEMO=0
